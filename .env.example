# Backend key: used on the server only (neighbourhood text, nearest places). Never exposed to the browser.
YATMO_BACKEND_KEY=your_backend_key
# Frontend key: embedded in the map iframe, locked to your domains in your Yatmo account.
NEXT_PUBLIC_YATMO_FRONTEND_KEY=your_frontend_key
# Country of the listings: BE, FR, NL, LU, CH, DE, IT, ES, PT, IE, UK, AT, CA, GR, MA, AU, HR, MT, SI, RS, CY, BA, ME, BG, AL
YATMO_COUNTRY=BE
